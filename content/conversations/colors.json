      "character_line": {
        "en": "Welcome to art class! What color do you want to use first?",
        "zh": "歡迎來到美術課！你第一個想用什麼顏色呢？"
      },
      "options": [
        {
          "id": "opt_1_1",
          "en": "I want to use bright yellow!",
          "zh": "我想用明亮的黃色！",
          "is_correct": true
        },
        {
          "id": "opt_1_2",
          "en": "I have two sisters.",
          "zh": "我有兩個姊妹。",
          "is_correct": false,
          "hint": "選擇一個你喜歡的顏色，比如「yellow」或「red」喔！"
        },
        {
          "id": "opt_1_3",
          "en": "My shoes are clean.",
          "zh": "我的鞋子很乾淨。",
          "is_correct": false,
          "hint": "告訴 Benny 你想用哪種繽紛的顏色開始畫畫吧！"
        }
