{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Badge",
  "type": "object",
  "required": [
    "id",
    "code",
    "name",
    "description",
    "condition",
    "category",
    "type",
    "display_count",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^badge\\.[a-z_]+\\.[a-z0-9_]+$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[0-9]{2}$",
      "description": "徽章代號，格式為「2 碼分類字母-該分類內 2 碼流水號」，例如 VM-01。字母對應 category 的固定縮寫（見文件的代號命名規則章節），同分類新增徽章接續流水號，新分類則指派新字母，兩者都不影響既有代號"
    },
    "name": {
      "type": "string",
      "description": "徽章名稱"
    },
    "description": {
      "type": "string",
      "description": "註解說明（玩家看到的說明文字）"
    },
    "condition": {
      "type": "string",
      "description": "獎勵條件（具體觸發邏輯，供工程/設計參考）"
    },
    "category": {
      "type": "string",
      "enum": [
        "onboarding",
        "vocab_milestone",
        "questions_milestone",
        "game_mastery",
        "unit_completion",
        "streak",
        "total_days",
        "performance",
        "favorites",
        "healthy_habit"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "one_time",
        "repeatable"
      ],
      "description": "one_time=終身只能取得一次；repeatable=條件反覆達成即反覆取得，並計算取得次數"
    },
    "reset_on_achieve": {
      "type": "boolean",
      "description": "僅 repeatable 類型有意義：達成後，底層計數器是否歸零重新累積（如連續天數類）。非連續型的 repeatable（如完美關卡）此欄位為 false，因為每次事件各自獨立判定，沒有『連續』的概念需要重置"
    },
    "display_count": {
      "type": "boolean",
      "description": "UI 是否需要在徽章下方顯示「已達成 N 次」"
    },
    "tier_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "同一系列分級徽章的分組鍵，供 UI 呈現進度序列"
    },
    "tier_level": {
      "type": [
        "integer",
        "null"
      ],
      "description": "在 tier_group 內的等級順序，1 為最低階"
    },
    "threshold": {
      "type": [
        "number",
        "null"
      ],
      "description": "觸發門檻數值，無明確數值條件則為 null"
    },
    "icon_placeholder": {
      "type": [
        "string",
        "null"
      ],
      "description": "預留欄位，徽章美術定案後填入圖檔路徑"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    }
  }
}