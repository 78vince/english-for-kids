{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Passage",
  "type": "object",
  "required": [
    "id",
    "title",
    "topic",
    "text",
    "vocab_ids",
    "questions",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pass\\.[a-z_]+\\.p[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "sentence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocab_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "answer",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single_choice"
            ]
          },
          "source_sentence": {
            "type": ["string", "null"],
            "description": "這一題答案對應到 text 裡的哪一句，原文照抄、逐字一致，給 Stage D 綜合關卡「只播放這一句」的朗讀按鈕用；選填，合併好幾句才答得出來的題目可以省略或設 null，退回播放整篇短文。"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    }
  }
}